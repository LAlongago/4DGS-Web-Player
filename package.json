{
  "name": "@4dgs/web-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable browser player for frame-sequence 4D Gaussian Splatting scenes",
  "license": "Apache-2.0",
  "main": "./dist/four-dgs-player.js",
  "module": "./dist/four-dgs-player.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/four-dgs-player.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsc -p tsconfig.build.json && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest run",
    "pack-scene": "tsx scripts/pack-scene.ts"
  },
  "dependencies": {
    "playcanvas": "2.21.4"
  },
  "devDependencies": {
    "@playcanvas/splat-transform": "^3.1.7",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
